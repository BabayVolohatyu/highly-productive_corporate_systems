{
  "info": {
    "name": "Server monitoring lab 1",
    "description": "CRUD, JWT, SecurityFilterChain 403, @PreAuthorize 403, Lab 3 validation and @CurrentOperator overview, Lab 4 AOP metering, budget timing, and masked GET.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "keycloakUrl", "value": "http://localhost:8081"},
    {"key": "apiClientSecret", "value": "monitoring-api-secret"},
    {"key": "adminToken", "value": ""},
    {"key": "operatorToken", "value": ""},
    {"key": "serverId", "value": ""},
    {"key": "lab4FindByIdBaseline", "value": "0"}
  ],
  "item": [
    {
      "name": "Auth - admin token (alice)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('admin token issued', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.collectionVariables.set('adminToken', pm.response.json().access_token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {"key": "grant_type", "value": "password"},
            {"key": "client_id", "value": "monitoring-api"},
            {"key": "client_secret", "value": "{{apiClientSecret}}"},
            {"key": "username", "value": "alice"},
            {"key": "password", "value": "alice"}
          ]
        },
        "url": "{{keycloakUrl}}/realms/monitoring/protocol/openid-connect/token"
      }
    },
    {
      "name": "Auth - operator token (bob)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('operator token issued', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.collectionVariables.set('operatorToken', pm.response.json().access_token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {"key": "grant_type", "value": "password"},
            {"key": "client_id", "value": "monitoring-api"},
            {"key": "client_secret", "value": "{{apiClientSecret}}"},
            {"key": "username", "value": "bob"},
            {"key": "password", "value": "bob"}
          ]
        },
        "url": "{{keycloakUrl}}/realms/monitoring/protocol/openid-connect/token"
      }
    },
    {
      "name": "Lab3 PROD with UNKNOWN status is 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 validation', function () { pm.response.to.have.status(400); });",
              "const body = pm.response.json();",
              "pm.test('message mentions production and UNKNOWN', function () {",
              "  pm.expect(body.error).to.match(/production/i);",
              "  pm.expect(body.error).to.match(/UNKNOWN/i);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{adminToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hostname\": \"bad-prod-host\",\n  \"ipAddress\": \"10.0.0.99\",\n  \"environment\": \"PROD\",\n  \"status\": \"UNKNOWN\",\n  \"description\": \"\"\n}"
        },
        "url": "{{baseUrl}}/api/servers"
      }
    },
    {
      "name": "AC5 missing token is 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('401', function () { pm.response.to.have.status(401); });"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/servers"
      }
    },
    {
      "name": "AC1 create server",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('serverId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{adminToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hostname\": \"edge-1\",\n  \"ipAddress\": \"10.0.0.15\",\n  \"environment\": \"PROD\",\n  \"status\": \"UP\",\n  \"description\": \"edge proxy\"\n}"
        },
        "url": "{{baseUrl}}/api/servers"
      }
    },
    {
      "name": "AC1 list servers",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('200', function () { pm.response.to.have.status(200); });"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
        "url": "{{baseUrl}}/api/servers"
      }
    },
    {
      "name": "AC1 get server",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('200', function () { pm.response.to.have.status(200); });"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
        "url": "{{baseUrl}}/api/servers/{{serverId}}"
      }
    },
    {
      "name": "AC1 update server",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('200', function () { pm.response.to.have.status(200); });"]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {"key": "Authorization", "value": "Bearer {{adminToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hostname\": \"edge-1\",\n  \"ipAddress\": \"10.0.0.16\",\n  \"environment\": \"STAGE\",\n  \"status\": \"MAINTENANCE\",\n  \"description\": \"patched\"\n}"
        },
        "url": "{{baseUrl}}/api/servers/{{serverId}}"
      }
    },
    {
      "name": "Lab4 overview baseline findByIdEntries",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set('lab4FindByIdBaseline', String(pm.response.json().findByIdEntries));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
        "url": "{{baseUrl}}/api/admin/overview"
      }
    },
    {
      "name": "Lab4 GET server via proxy counts findById",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', function () { pm.response.to.have.status(200); });",
              "pm.test('hostname unchanged', function () {",
              "  pm.expect(pm.response.json().hostname).to.eql('edge-1');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
        "url": "{{baseUrl}}/api/servers/{{serverId}}"
      }
    },
    {
      "name": "Lab4 overview after proxy get",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', function () { pm.response.to.have.status(200); });",
              "const baseline = parseInt(pm.collectionVariables.get('lab4FindByIdBaseline'), 10);",
              "const body = pm.response.json();",
              "pm.test('findById counter increased by one', function () {",
              "  pm.expect(body.findByIdEntries).to.eql(baseline + 1);",
              "});",
              "pm.test('lastListMillis recorded from list', function () {",
              "  pm.expect(body.lastListMillis).to.be.at.least(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
        "url": "{{baseUrl}}/api/admin/overview"
      }
    },
    {
      "name": "Lab4 GET unmetered self-invocation",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', function () { pm.response.to.have.status(200); });",
              "pm.test('same hostname as proxied get', function () {",
              "  pm.expect(pm.response.json().hostname).to.eql('edge-1');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
        "url": "{{baseUrl}}/api/servers/{{serverId}}/unmetered"
      }
    },
    {
      "name": "Lab4 overview after unmetered get",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', function () { pm.response.to.have.status(200); });",
              "const baseline = parseInt(pm.collectionVariables.get('lab4FindByIdBaseline'), 10);",
              "pm.test('findById counter unchanged by self-invocation', function () {",
              "  pm.expect(pm.response.json().findByIdEntries).to.eql(baseline + 1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
        "url": "{{baseUrl}}/api/admin/overview"
      }
    },
    {
      "name": "Lab4 GET masked management address",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('hostname unchanged', function () { pm.expect(body.hostname).to.eql('edge-1'); });",
              "pm.test('ipAddress masked in response only', function () { pm.expect(body.ipAddress).to.eql('10.0.0.***'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
        "url": "{{baseUrl}}/api/servers/{{serverId}}/masked"
      }
    },
    {
      "name": "Lab4 overview after masked get",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', function () { pm.response.to.have.status(200); });",
              "const baseline = parseInt(pm.collectionVariables.get('lab4FindByIdBaseline'), 10);",
              "pm.test('findById counter still unchanged', function () {",
              "  pm.expect(pm.response.json().findByIdEntries).to.eql(baseline + 1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
        "url": "{{baseUrl}}/api/admin/overview"
      }
    },
    {
      "name": "AC6 operator forbidden on admin path",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('403 from SecurityFilterChain', function () { pm.response.to.have.status(403); });"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{operatorToken}}"}],
        "url": "{{baseUrl}}/api/admin/overview"
      }
    },
    {
      "name": "AC6 admin overview allowed",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', function () { pm.response.to.have.status(200); });",
              "pm.test('requestedBy is alice', function () {",
              "  pm.expect(pm.response.json().requestedBy).to.eql('alice');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
        "url": "{{baseUrl}}/api/admin/overview"
      }
    },
    {
      "name": "AC7 operator forbidden on delete",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('403 from PreAuthorize', function () { pm.response.to.have.status(403); });"]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [{"key": "Authorization", "value": "Bearer {{operatorToken}}"}],
        "url": "{{baseUrl}}/api/servers/{{serverId}}"
      }
    },
    {
      "name": "AC1 admin delete server",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('204', function () { pm.response.to.have.status(204); });"]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
        "url": "{{baseUrl}}/api/servers/{{serverId}}"
      }
    }
  ]
}
